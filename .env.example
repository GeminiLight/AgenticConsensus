# AgenticConsensus keeps model use disabled until explicitly enabled.
# Optional: store .env, var/, and the demo repository under a stable directory.
# AGENTIC_CONSENSUS_HOME=/absolute/operator-owned/path
CONSENSUS_LLM_ENABLED=false
CONSENSUS_LLM_PROVIDER=openai_responses
CONSENSUS_LLM_TIMEOUT=30
# Structured Review Copilot answers need room; 700 is the floor for concise models, 1200 suits reasoning models.
CONSENSUS_LLM_MAX_TOKENS=700
CONSENSUS_LLM_STRUCTURED_OUTPUT=json_schema

# OpenAI Responses API or an OpenAI-compatible gateway.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=

# Set CONSENSUS_LLM_PROVIDER=openai_chat for Chat Completions gateways.
OPENAI_CHAT_MAX_TOKENS_FIELD=max_completion_tokens
# Optional gateway extension for reasoning models that expose a thinking switch.
# OPENAI_CHAT_THINKING=disabled

# Example: BigModel Coding Plan (replace the values above; never commit a real key).
# CONSENSUS_LLM_ENABLED=true
# CONSENSUS_LLM_PROVIDER=openai_chat
# CONSENSUS_LLM_TIMEOUT=60
# CONSENSUS_LLM_MAX_TOKENS=2400
# CONSENSUS_LLM_STRUCTURED_OUTPUT=json_object
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# OPENAI_MODEL=glm-5.3-flash
# OPENAI_CHAT_MAX_TOKENS_FIELD=max_tokens
# OPENAI_CHAT_THINKING=disabled
# Set OPENAI_API_KEY only in your private .env or deployment secret store.

# Set CONSENSUS_LLM_PROVIDER=anthropic to use Anthropic Messages.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Advanced deployment override only. Ordinary users click Connect GitHub;
# the first administrator provisions the read-only App in the browser and
# does not set these values. Centrally managed deployments may preconfigure
# a GitHub App with callback http://127.0.0.1:8765/api/github/oauth/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=

# Optional GitHub Enterprise or local integration-test endpoints.
GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_URL=https://api.github.com
# GITHUB_CLONE_HOST=github.example.com
CONSENSUS_GITHUB_TIMEOUT=20
# CONSENSUS_GITHUB_REPOSITORIES_DIR=/absolute/operator-owned/repositories
# CONSENSUS_GITHUB_TOKEN_KEY_PATH=/absolute/operator-owned/github-token.key
